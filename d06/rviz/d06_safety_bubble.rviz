# D06 only: RViz2 READ-ONLY displays; yellow/red rings are classroom annotations.
# The rings are not official Collision Monitor polygon/action ground truth.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RobotModel1
        - /TF1
        - /Raw LaserScan1
        - /Odometry1
        - /Educational Bubble Overlay1
      Splitter Ratio: 0.55
    Tree Height: 500
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: true
      Alpha: 0.4
      Color: 155; 155; 155
      Cell Size: 0.5
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Collision Enabled: false
      Visual Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
      TF Prefix: ""
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.45
      Show Arrows: true
      Show Axes: false
      Show Names: false
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Raw LaserScan
      Enabled: true
      Alpha: 1
      Color Transformer: FlatColor
      Color: 65; 210; 230
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 4
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Keep: 30
      Color: 45; 225; 95
      Shape: Arrow
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /odom
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Educational Bubble Overlay
      Enabled: true
      Marker Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /axia/d06/rviz/bubble
      Value: true
  Enabled: true
  Global Options:
    Background Color: 32; 35; 42
    Fixed Frame: odom
    Frame Rate: 20
  Name: D06 G07 Safety Bubble Observation ONLY
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.9
      Target Frame: base_footprint
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Height: 920
  Width: 1450
  X: 60
  Y: 60
